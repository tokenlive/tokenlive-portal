{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portal Backend API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/portal-api",
      "output": "${workspaceFolder}/bin/portal-api-debug",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PORTAL_ENV": "development",
        "PORTAL_HTTP_ADDR": ":8080"
      }
    },
    {
      "name": "Portal Backend Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/portal-worker",
      "output": "${workspaceFolder}/bin/portal-worker-debug",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PORTAL_ENV": "development"
      }
    },
    {
      "name": "Portal Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "env": {
        "NEXT_PUBLIC_API_URL": "http://localhost:8080"
      },
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Portal Full Stack",
      "configurations": ["Portal Backend API", "Portal Web"],
      "stopAll": true
    }
  ]
}
