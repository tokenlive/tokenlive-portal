# TokenLive Portal - 后端配置

# 运行环境 (development/production)
PORTAL_ENV=development

# HTTP 监听地址
PORTAL_HTTP_ADDR=:8080

# 数据库连接字符串 (MySQL)
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
PORTAL_DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/tokenlive_portal?charset=utf8mb4&parseTime=True&loc=Local

# 密码加密 pepper (生产环境必须设置强密码)
PORTAL_AUTH_PEPPER=dev-auth-pepper-change-this-in-production

# 试用金配置 (单位: micro-CNY, 10_000_000 = 10元)
PORTAL_TRIAL_CREDIT_MICRO_CNY=10000000
PORTAL_TRIAL_CREDIT_TTL_DAYS=7

# Gateway runtime Redis (可选；配置后 Portal API Key 会同步到 Gateway runtime)
PORTAL_GATEWAY_REDIS_ADDR=
PORTAL_GATEWAY_REDIS_PASSWORD=
PORTAL_GATEWAY_REDIS_DB=0

# Google OAuth (可选)
PORTAL_GOOGLE_CLIENT_ID=
PORTAL_GOOGLE_CLIENT_SECRET=
PORTAL_GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# GitHub OAuth (可选)
PORTAL_GITHUB_CLIENT_ID=
PORTAL_GITHUB_CLIENT_SECRET=
PORTAL_GITHUB_REDIRECT_URL=http://localhost:8080/api/auth/github/callback
